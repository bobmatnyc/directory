{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://counterparts.ai/directory/system.schema.json",
  "title": "A memory system in the Counterparts directory",
  "definitions": {
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "built",
            "partial",
            "none",
            "unknown"
          ],
          "description": "built = does it on purpose; partial = some of it, or only as a side effect; none = doesn't; unknown = a closed product whose docs don't say."
        },
        "depth": {
          "enum": [
            1,
            2,
            3,
            4
          ],
          "description": "How far it goes. partial is 1 (a little) or 2 (partly); built is 3 (built) or 4 (built in depth). The bar for each step is in mechanisms.yaml."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "One plain sentence: what it does here, or doesn't."
        },
        "only": {
          "type": "string",
          "minLength": 1,
          "description": "When only one edition has it, e.g. \"cloud only\"."
        },
        "source": {
          "type": "string",
          "pattern": "^https://\\S+$",
          "description": "A link that backs this grade: docs, code, or the maker's own words. Required for built and partial."
        },
        "dev": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "note"
          ],
          "properties": {
            "to": {
              "enum": [
                "built",
                "partial"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Being built now, by the makers' own account: how far it will go, and what's coming."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "built"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "depth",
              "source"
            ],
            "properties": {
              "depth": {
                "enum": [
                  3,
                  4
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "depth",
              "source"
            ],
            "properties": {
              "depth": {
                "enum": [
                  1,
                  2
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "none",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "depth"
              ]
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "tagline",
    "category",
    "maker",
    "links",
    "openness",
    "summary",
    "forWho",
    "remembers",
    "doesnt",
    "standout",
    "facts",
    "hood",
    "mechanisms",
    "checked",
    "sources"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The page's address (counterparts.ai/directory/<slug>/) and this file's name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "One plain line for the card."
    },
    "category": {
      "enum": [
        "self",
        "user",
        "work",
        "blocks"
      ],
      "description": "Whose memory is it? self = the AI's own; user = memory about you; work = work & project memory; blocks = building blocks for developers."
    },
    "alsoIn": {
      "type": "array",
      "items": {
        "enum": [
          "self",
          "user",
          "work",
          "blocks"
        ]
      },
      "description": "Other categories it also fits, for the filters."
    },
    "maker": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "website"
      ],
      "properties": {
        "website": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "description": "GitHub \"owner/name\", main one first. Stars are fetched when the site builds."
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "registry",
              "name"
            ],
            "properties": {
              "registry": {
                "enum": [
                  "npm",
                  "pypi"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Weekly downloads are fetched when the site builds."
        }
      }
    },
    "openness": {
      "enum": [
        "open",
        "partly",
        "closed"
      ],
      "description": "How much of it you can read and run yourself."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "A short paragraph a newcomer can follow."
    },
    "forWho": {
      "type": "string",
      "minLength": 1
    },
    "remembers": {
      "type": "string",
      "minLength": 1
    },
    "doesnt": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What it doesn't do, said plainly."
    },
    "standout": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Its most distinctive ideas."
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lives",
        "local",
        "keys",
        "worksWith",
        "license",
        "price"
      ],
      "properties": {
        "lives": {
          "type": "string",
          "minLength": 1,
          "description": "Where the memory lives, short: \"Your machine\", \"Their cloud or yours\"."
        },
        "local": {
          "type": "boolean",
          "description": "Can the memory live on your own machine?"
        },
        "keys": {
          "type": "string",
          "minLength": 1
        },
        "worksWith": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runs",
            "needs",
            "works"
          ],
          "properties": {
            "runs": {
              "type": "array",
              "items": {
                "enum": [
                  "local",
                  "server",
                  "cloud"
                ]
              },
              "description": "Where the memory can live: your machine, self-hosted, their cloud."
            },
            "needs": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "account",
                  "model-key",
                  "their-key"
                ]
              },
              "description": "What you need to set up: no keys, an account, an AI model key, their key."
            },
            "works": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "worksWith, in a word or two each, the most useful first."
            }
          },
          "description": "The same facts as short tags, for the card."
        }
      }
    },
    "hood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "stores",
        "finds",
        "cost"
      ],
      "properties": {
        "writes": {
          "type": "string",
          "minLength": 1,
          "description": "Who decides what gets saved, and when."
        },
        "stores": {
          "type": "string",
          "minLength": 1,
          "description": "Where and in what it's kept."
        },
        "finds": {
          "type": "string",
          "minLength": 1,
          "description": "How memories are found again."
        },
        "cost": {
          "type": "string",
          "minLength": 1,
          "description": "AI calls beyond the conversation itself."
        }
      },
      "description": "The four things a developer compares first."
    },
    "mechanisms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salience",
        "emotional",
        "decay",
        "interference",
        "retrieval",
        "association",
        "prospective",
        "consolidation",
        "reconsolidation",
        "episodic-semantic",
        "schema"
      ],
      "properties": {
        "salience": {
          "$ref": "#/definitions/rating"
        },
        "emotional": {
          "$ref": "#/definitions/rating"
        },
        "decay": {
          "$ref": "#/definitions/rating"
        },
        "interference": {
          "$ref": "#/definitions/rating"
        },
        "retrieval": {
          "$ref": "#/definitions/rating"
        },
        "association": {
          "$ref": "#/definitions/rating"
        },
        "prospective": {
          "$ref": "#/definitions/rating"
        },
        "consolidation": {
          "$ref": "#/definitions/rating"
        },
        "reconsolidation": {
          "$ref": "#/definitions/rating"
        },
        "episodic-semantic": {
          "$ref": "#/definitions/rating"
        },
        "schema": {
          "$ref": "#/definitions/rating"
        }
      },
      "description": "One grade for each of the 11 mechanisms in mechanisms.yaml."
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "detail"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "label"
          ],
          "properties": {
            "to": {
              "type": "integer",
              "minimum": 0
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "An arrow from the last step back to an earlier one (counted from 0)."
        }
      },
      "description": "A box-and-arrow sketch of how it works, left to right."
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "When someone last checked this entry against the sources."
    },
    "confirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "on"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub handle of the maker who confirmed it."
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "description": "Set by the directory's maintainers when the system's own makers have confirmed the entry. Leave it out of your pull request."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          }
        }
      }
    }
  }
}
